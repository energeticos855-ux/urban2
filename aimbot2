-- ============ LOS (Wall Check) ============
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.IgnoreWater = true

local function refreshLOSFilter()
    local list = {}
    if LocalPlayer.Character then table.insert(list, LocalPlayer.Character) end
    losParams.FilterDescendantsInstances = list
end
refreshLOSFilter()
LocalPlayer.CharacterAdded:Connect(function() task.wait(0.1); refreshLOSFilter() end)

local function hasLOS(targetChar, targetPart)
    if not CFG.WallCheck then return true end
    if not targetChar or not targetPart then return false end
    local origin = Camera.CFrame.Position
    local dir = targetPart.Position - origin
    local result = workspace:Raycast(origin, dir, losParams)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(targetChar)
end

-- ============ SILENT AIM HOOK (opcional) ============
local targetHead = nil
local hookOK = hookmetamethod and getrawmetatable and newcclosure and checkcaller and setreadonly
if not hookOK then
    warn("[Wasty] executor sem hooks — silent aim OFF, camera aim ativo")
end

if hookOK then
    local mt = getrawmetatable(game)
    setreadonly(mt, false)

    local oldIndex = mt.__index
    mt.__index = newcclosure(function(self, key)
        if not checkcaller() then
            if key == "Hit" and CFG.Aimbot and targetHead and targetHead.Parent then
                return CFrame.new(targetHead.Position)
            end
        end
        return oldIndex(self, key)
    end)

    local oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if not checkcaller() then
            if (method == "ScreenPointToRay" or method == "ViewportPointToRay") and targetHead and targetHead.Parent then
                local origin = Camera.CFrame.Position
                local aimDir = (targetHead.Position - origin).Unit
                return Ray.new(origin, aimDir * 5000)
            end
            if (method == "Raycast" or method == "FindPartOnRay") and type(args[1]) == "Ray" and targetHead and targetHead.Parent then
                local ray = args[1]
                args[1] = Ray.new(ray.Origin, (targetHead.Position - ray.Origin).Unit * 5000)
                return oldNamecall(self, unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end

-- ============ SPEED (toggle + multi-layer enforcement) ============
local function enforceSpeed()
    if not CFG.SpeedEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local target = math.clamp(CFG.Speed, 16, 28)
    if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
end

RunService.Heartbeat:Connect(enforceSpeed)
RunService.Stepped:Connect(enforceSpeed)

local function bindHumanoid(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if CFG.SpeedEnabled then
            local target = math.clamp(CFG.Speed, 16, 28)
            if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
        end
    end)
end

if LocalPlayer.Character then bindHumanoid(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(bindHumanoid)

