-- ============ MAIN LOOP (aimbot com LOS) ============
RunService.RenderStepped:Connect(function(dt)
    if CFG.Aimbot then
        fovCircle.Visible = true
        fovCircle.Radius = CFG.AimFOV
        fovCircle.Position = Camera.ViewportSize / 2
    else
        fovCircle.Visible = false
        aimTracer.Visible = false
    end

    if Camera and Camera.FieldOfView ~= CFG.FOV then Camera.FieldOfView = CFG.FOV end

    local char = LocalPlayer.Character
    if CFG.Spin and char and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            spinAngle = (spinAngle + (CFG.SpinSpeed * 10 * dt)) % 360
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
        end
    end

    if CFG.LocalRGB and char then
        local col = Color3.fromHSV((tick() * 0.3) % 1, 1, 1)
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.Color = col end
        end
    end

    if CFG.Aimbot and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local center = Camera.ViewportSize / 2
        local closestHead, shortestDist = nil, CFG.AimFOV

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not (CFG.TeamCheck and plr.Team and plr.Team == LocalPlayer.Team) then
                local pchar = plr.Character
                local head = pchar and pchar:FindFirstChild("Head")
                local hum = pchar and pchar:FindFirstChildOfClass("Humanoid")
                if head and head.Parent and hum and hum.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen and screenPos.Z > 0 then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < shortestDist then
                            -- LOS check só depois do filtro de FOV (mais barato)
                            if hasLOS(pchar, head) then
                                shortestDist = dist
                                closestHead = head
                            end
                        end
                    end
                end
            end
        end

        if closestHead then
            targetHead = closestHead
            local screenPos = Camera:WorldToViewportPoint(closestHead.Position)
            local speedFactor = math.clamp(CFG.AimSpeed / 5, 0.05, 1)

            if mousemoverel then
                local dx = (screenPos.X - center.X) * speedFactor
                local dy = (screenPos.Y - center.Y) * speedFactor
                mousemoverel(dx, dy)
            end

            local camCF = CFrame.new(Camera.CFrame.Position, closestHead.Position)
            Camera.CFrame = Camera.CFrame:Lerp(camCF, speedFactor)

            aimTracer.Visible = true
            aimTracer.From = center
            aimTracer.To = Vector2.new(screenPos.X, screenPos.Y)
        else
            targetHead = nil
            aimTracer.Visible = false
        end
    else
        targetHead = nil
        aimTracer.Visible = false
    end
end)

-- ============ DRAWING ESP ============
local draws = {}
local function newDraw(cls, props)
    local d = Drawing.new(cls)
    for k, v in pairs(props) do d[k] = v end
    return d
end
local function ensure(plr)
    if draws[plr] then return draws[plr] end
    draws[plr] = {
        box    = newDraw("Square", {Thickness=1, Filled=false, Visible=false}),
        name   = newDraw("Text", {Size=14, Center=true, Outline=true, Visible=false}),
        hp     = newDraw("Text", {Size=12, Center=false, Outline=true, Color=Color3.fromRGB(0,255,0), Visible=false}),
        dist   = newDraw("Text", {Size=12, Center=true, Outline=true, Visible=false}),
        tracer = newDraw("Line", {Thickness=1.5, Visible=false}),
    }
    return draws[plr]
end
local function w2s(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    if not on or sp.Z <= 0 then return nil end
    return Vector2.new(sp.X, sp.Y)
end

RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        local hide = plr == LocalPlayer or (CFG.TeamCheck and plr.Team and plr.Team == LocalPlayer.Team)
        if hide then
            if draws[plr] then for _, o in pairs(draws[plr]) do o.Visible = false end end
        else
            local char = plr.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            if char and hum and hrp and head and hum.Health > 0 then
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                local hs = w2s(head.Position + Vector3.new(0, 0.5, 0))
                local fs = w2s(hrp.Position - Vector3.new(0, 3, 0))
                if dist < CFG.MaxDist and hs and fs then
                    local d = ensure(plr)
                    local h, w = math.abs(fs.Y - hs.Y), math.abs(fs.Y - hs.Y) * 0.55
                    local cx, ty = (hs.X + fs.X) * 0.5, math.min(hs.Y, fs.Y)
                    d.box.Size, d.box.Position, d.box.Color = Vector2.new(w, h), Vector2.new(cx - w/2, ty), c3(CFG.BoxColor)
                    d.box.Visible = CFG.Enabled and CFG.Box
                    d.name.Text, d.name.Position, d.name.Color = plr.Name, Vector2.new(cx, ty - 16), c3(CFG.NameColor)
                    d.name.Visible = CFG.Enabled and CFG.Name
                    d.hp.Text, d.hp.Position = string.format("HP: %d", math.floor(hum.Health)), Vector2.new(cx - w/2, ty + h + 2)
                    d.hp.Visible = CFG.Enabled and CFG.Health
                    d.dist.Text, d.dist.Position, d.dist.Color = string.format("[%dm]", math.floor(dist)), Vector2.new(cx, ty + h + 16), c3(CFG.NameColor)
                    d.dist.Visible = CFG.Enabled and CFG.Distance
                    if CFG.Enabled and CFG.Tracer then
                        local vp = Camera.ViewportSize
                        d.tracer.From = Vector2.new(vp.X/2, vp.Y)
                        d.tracer.To = Vector2.new(cx, ty + h/2)
                        d.tracer.Color = c3(CFG.TracerColor)
                        d.tracer.Visible = true
                    else
                        d.tracer.Visible = false
                    end
                else
                    if draws[plr] then for _, o in pairs(draws[plr]) do o.Visible = false end end
                end
            else
                if draws[plr] then for _, o in pairs(draws[plr]) do o.Visible = false end end
            end
        end
    end
end)

