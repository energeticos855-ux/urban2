        CFG[key] = not CFG[key]
        box.BackgroundColor3 = CFG[key] and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(45, 45, 55)
        chk.Visible = CFG[key]
        if callback then callback(CFG[key]) end
        saveConfig()
    end)

    addElement(parent, row, 36)
end

local function makeSlider(label, key, min, max, suffix, parent)
    local holder = Instance.new("Frame")
    holder.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    holder.BorderSizePixel = 0

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 0, 20); lbl.Position = UDim2.new(0, 12, 0, 4)
    lbl.BackgroundTransparency = 1; lbl.Text = string.format("%s: %.1f%s", label, CFG[key], suffix or "")
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230); lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = holder

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -24, 0, 12); bg.Position = UDim2.new(0, 12, 0, 28)
    bg.BackgroundColor3 = Color3.fromRGB(40, 40, 50); bg.BorderSizePixel = 0; bg.Parent = holder
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)

    local fill = Instance.new("Frame")
    local pct = (CFG[key] - min) / (max - min)
    fill.Size = UDim2.new(pct, 0, 1, 0); fill.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
    fill.BorderSizePixel = 0; fill.Parent = bg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1; btn.Text = ""; btn.Parent = bg

    local draggingSlider = false
    local function update(x)
        local p = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        CFG[key] = min + p * (max - min)
        if key ~= "AimSmooth" and key ~= "AimSpeed" then CFG[key] = math.floor(CFG[key]) end
        fill.Size = UDim2.new(p, 0, 1, 0)
        lbl.Text = string.format("%s: %.1f%s", label, CFG[key], suffix or "")
    end
    btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true; update(inp.Position.X) end
    end)
    UIS.InputChanged:Connect(function(inp)
        if draggingSlider and inp.UserInputType == Enum.UserInputType.MouseMovement then update(inp.Position.X) end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false; saveConfig() end
    end)

    addElement(parent, holder, 50)
end

